# Copy to lab/.env (or run `dac lab init` to generate random secrets).
# lab/.env is git-ignored. Never commit real credentials.

STACK_VERSION=8.17.4

ES_PORT=9200
KIBANA_PORT=5601
ES_MEM=1g

# Superuser (only used by `dac lab setup`)
ELASTIC_PASSWORD=changeme
# Password for the built-in kibana_system user
KIBANA_PASSWORD=changeme
# At least 32 characters
KIBANA_ENCRYPTION_KEY=changeme-changeme-changeme-changeme

# Filled in by `dac lab setup`
DAC_ES_URL=http://localhost:9200
DAC_KIBANA_URL=http://localhost:5601
DAC_PIPELINE_PASSWORD=
DAC_API_KEY=
