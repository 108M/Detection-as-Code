any where (event.category:"process" and event.type:"start") and ((process.executable.caseless:"*\\schtasks.exe" or process.pe.original_file_name:"schtasks.exe") and process.command_line like~ ("* -create *", "* /create *", "* –create *", "* —create *", "* ―create *") and (process.command_line like~ ("*powershell*", "*pwsh*", "*cmd /c*", "*cmd.exe /c*", "*mshta*", "*wscript*", "*cscript*", "*rundll32*", "*regsvr32*", "*\\AppData\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*C:\\ProgramData\\*")))
