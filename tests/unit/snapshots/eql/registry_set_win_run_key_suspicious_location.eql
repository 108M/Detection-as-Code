any where (winlog.channel:"Microsoft-Windows-Sysmon/Operational" and event.code:"13") and (((registry.path like~ ("*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\*", "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce\\*", "*\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run\\*")) and (winlog.event_data.Details like~ ("*\\AppData\\Local\\Temp\\*", "*\\Windows\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Roaming\\*", "*C:\\ProgramData\\*", "*powershell*", "*mshta*", "*wscript*", "*cscript*", "*rundll32*"))) and (not winlog.event_data.Details:"*\\AppData\\Local\\Microsoft\\OneDrive\\*"))
