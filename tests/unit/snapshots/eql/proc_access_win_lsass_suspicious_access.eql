any where (winlog.channel:"Microsoft-Windows-Sysmon/Operational" and event.code:"10") and ((winlog.event_data.TargetImage:"*\\lsass.exe" and (winlog.event_data.GrantedAccess like~ ("0x1010", "0x1438", "0x143a", "0x1fffff"))) and (not (((process.executable.caseless like~ ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*")) and (process.executable.caseless like~ ("*\\wininit.exe", "*\\csrss.exe", "*\\services.exe", "*\\svchost.exe", "*\\lsm.exe", "*\\wmiprvse.exe"))) or (process.executable.caseless:"C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" and process.executable.caseless:"*\\MsMpEng.exe"))))
